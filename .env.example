# ============= PROXY CONFIGURATION (SECURE) =============
# Use format: http://user:password@ip:port
PROXY_IP=your_proxy_ip_here
PROXY_PORT=8080
PROXY_USER=your_proxy_username
PROXY_PASS=your_proxy_password

# ============= KICKSTARTER DISCOVERY =============
# Use pipe (|) operator to separate keywords
# Example: travel bag|backpack|sling bag|duffel bag
KICKSTARTER_KEYWORDS=travel bag
KICKSTARTER_DAYS_BACK=14
KICKSTARTER_MAX_PAGES=10
KICKSTARTER_REQUEST_DELAY=1

# ============= CLICKUP INTEGRATION =============
# Get from ClickUp admin or copy from URL
# Workspace/Channel IDs: Copy from ClickUp URL (workspaces/{id}/chat/channels/{id})
# CLICKUP_API_KEY is used for:
# - Fetching Brand Voice and Extraction SOP documents (Phase 2)
# - Sending failure alerts to chat channel (Cloudflare blocks, pipeline crashes)
CLICKUP_WORKSPACE_ID=your_workspace_id
CLICKUP_CHANNEL_ID=your_channel_id
CLICKUP_VOICE_DOC_ID=your_voice_doc_id
CLICKUP_VOICE_PAGE_ID=your_voice_page_id
CLICKUP_SOP_EXTRACTION_DOC_ID=your_sop_doc_id
CLICKUP_SOP_EXTRACTION_PAGE_ID=your_sop_page_id
CLICKUP_API_KEY=your_clickup_api_key

# ============= OPENAI LLM =============
# Get from OpenAI dashboard (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key

# ============= SUPABASE DATABASE =============
# Get from Supabase project settings (https://supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_public_key

# ============= LOGGING =============
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
